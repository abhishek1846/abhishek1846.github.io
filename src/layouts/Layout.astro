---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Abhishek Singh",
  description = "Staff Product Manager leading Non-Human Identity & AI Agent Governance at Oleria. 2x Founder, builder of Gatsby, IIT BHU alumnus.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Instant Client-Side SPA Transitions -->
    <ClientRouter />

    <!-- Instant Theme Setter (Zero FOUC - defaults to light mode) -->
    <script is:inline>
      function applyTheme() {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between selection:bg-neutral-900 selection:text-white dark:selection:bg-[#4eacf8]/30 dark:selection:text-[#e8eaed]">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 w-full flex-1 pt-8 pb-20">
      <slot />
    </div>

    <script is:inline>
      window.toggleTheme = function() {
        const root = document.documentElement;
        const isDark = root.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      };
    </script>

    <script>
      import { navigate } from 'astro:transitions/client';

      // High-performance in-memory HTML cache for instant (0ms) page swaps
      const pageCache = new Map<string, string>();

      async function prefetchToMemory(href: string) {
        try {
          const url = new URL(href, window.location.href);
          if (url.origin !== window.location.origin) return;
          const cleanKey = url.pathname.replace(/\/$/, '') || '/';
          if (pageCache.has(cleanKey)) return;

          const res = await fetch(url.href, { priority: 'low' });
          if (res.ok && (res.headers.get('content-type') || '').includes('text/html')) {
            const html = await res.text();
            pageCache.set(cleanKey, html);
          }
        } catch {}
      }

      // Serve instantly from in-memory cache during View Transitions
      document.addEventListener('astro:before-preparation', (event: any) => {
        try {
          const url = new URL(event.to.href, window.location.href);
          const cleanKey = url.pathname.replace(/\/$/, '') || '/';
          const cached = pageCache.get(cleanKey);
          if (cached) {
            event.loader = async () => {
              event.newDocument = new DOMParser().parseFromString(cached, 'text/html');
            };
          }
        } catch {}
      });

      // Speculative prefetching on hover, touch, and focus
      function attachPrefetchListeners() {
        const links = document.querySelectorAll<HTMLAnchorElement>('a[href^="/"], a[href^="' + window.location.origin + '"]');
        links.forEach((link) => {
          const href = link.getAttribute('href');
          if (!href || href.startsWith('#') || link.hasAttribute('download') || href.endsWith('.pdf')) return;

          const handler = () => prefetchToMemory(link.href);
          link.addEventListener('pointerenter', handler, { passive: true, once: true });
          link.addEventListener('pointerdown', handler, { passive: true, once: true });
          link.addEventListener('focusin', handler, { passive: true, once: true });
        });
      }

      // Background idle warming: prefetch all links visible on the page
      function warmUpIdle() {
        attachPrefetchListeners();
        const requestIdle = (window as any).requestIdleCallback || ((cb: Function) => setTimeout(cb, 60));
        requestIdle(() => {
          const links = document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]');
          links.forEach((link) => {
            const href = link.getAttribute('href');
            if (href && !href.startsWith('#') && !link.hasAttribute('download') && !href.endsWith('.pdf')) {
              prefetchToMemory(link.href);
            }
          });
        });
      }

      warmUpIdle();
      document.addEventListener('astro:page-load', attachPrefetchListeners);

      // Keyboard shortcuts (1: Home, 2: Writing, 3: Work, 4: Projects, 5: Books, 6: Uses, 7: About)
      if (!(window as any).__portfolioKeydownInit) {
        (window as any).__portfolioKeydownInit = true;
        document.addEventListener('keydown', (e) => {
          if (['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;

          const routes: Record<string, string> = {
            '1': '/',
            '2': '/writing',
            '3': '/projects',
            '4': '/books',
            '5': '/uses',
            '6': '/about',
          };

          if (routes[e.key] && window.location.pathname !== routes[e.key]) {
            navigate(routes[e.key]);
          }
        });
      }
    </script>
  </body>
</html>
