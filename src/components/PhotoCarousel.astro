---
const slides = [
  {
    id: "dsci-paper",
    tag: "National Publication",
    title: "Identity Security in the AI Era",
    subtitle: "Co-authored with DSCI (Data Security Council of India)",
    date: "2026",
    linkText: "Read paper on DSCI ↗",
    href: "https://www.dsci.in/resource/content/identity-security-maturity-ai-era",
    image: "/images/dsci-paper-thumb.webp",
    type: "paper",
  },
  {
    id: "conf-gartner-srm",
    tag: "Industry Conference",
    title: "Gartner Security & Risk Management Summit",
    subtitle: "Represented Oleria at Gartner SRM, discussing identity governance and AI security with enterprise leaders.",
    date: "Conference",
    linkText: "View conference details →",
    href: "/about#conf-gartner-srm",
    type: "conference",
  },
  {
    id: "conf-identiverse",
    tag: "Identity Conference",
    title: "Identiverse",
    subtitle: "Represented Oleria at Identiverse, connecting with the identity security community on NHIs and IAM.",
    date: "Conference",
    linkText: "View conference details →",
    href: "/about#conf-identiverse",
    type: "conference",
  },
  {
    id: "meetup-iam-nhi",
    tag: "Community Meetup",
    title: "IAM Meetup: Non-Human Identity Security",
    subtitle: "Gave a talk on Non-Human Identity security, machine credentials, and enterprise blast radius.",
    date: "Meetup Talk",
    linkText: "View talk details →",
    href: "/about#meetup-iam-nhi",
    type: "meetup",
  },
];
---

<div class="space-y-3">
  <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-neutral-900">
    <div class="flex items-center gap-2">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
        Publications, Conferences & Meetups
      </h2>
      <span class="text-[11px] font-mono text-neutral-400">
        (<span id="carousel-current">1</span>/{slides.length})
      </span>
    </div>

    <!-- Manual Carousel Controls (Click-driven only) -->
    <div class="flex items-center gap-1.5">
      <button 
        id="carousel-prev" 
        aria-label="Previous slide"
        class="p-1 rounded text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button 
        id="carousel-next" 
        aria-label="Next slide"
        class="p-1 rounded text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Carousel Viewport -->
  <div class="relative overflow-hidden rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/60 dark:bg-neutral-900/40">
    <div id="carousel-track" class="flex transition-transform duration-300 ease-out">
      {slides.map((slide) => (
        <div class="w-full shrink-0 p-5 sm:p-6 flex flex-col sm:flex-row items-center gap-5 sm:gap-6">
          <!-- Visual Card -->
          <div class="w-full sm:w-48 h-36 shrink-0 rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-950 flex flex-col justify-between p-3.5 shadow-xs relative">
            {slide.image ? (
              <div class="absolute inset-0 flex items-center justify-center bg-neutral-100 dark:bg-neutral-900 overflow-hidden">
                <img 
                  src={slide.image} 
                  alt={slide.title} 
                  class="w-full h-full object-cover" 
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between text-white text-[10px] font-mono">
                  <span class="bg-black/60 px-1.5 py-0.5 rounded backdrop-blur-xs">{slide.tag}</span>
                  <span class="bg-black/60 px-1.5 py-0.5 rounded backdrop-blur-xs">{slide.date}</span>
                </div>
              </div>
            ) : (
              <>
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono uppercase tracking-wider px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 font-medium">
                    {slide.tag}
                  </span>
                  <span class="text-[10px] font-mono text-neutral-400">{slide.date}</span>
                </div>

                <!-- Graphic / Mock Icon per slide type -->
                <div class="my-auto py-2">
              {slide.type === 'paper' && (
                <div class="space-y-1">
                  <div class="w-6 h-6 rounded bg-blue-50 dark:bg-blue-950 flex items-center justify-center text-blue-600 dark:text-blue-400">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </div>
                  <p class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100 leading-tight">DSCI Whitepaper</p>
                  <p class="text-[9px] text-neutral-500 font-mono">National Industry Report</p>
                </div>
              )}

              {slide.type === 'conference' && (
                <div class="space-y-1">
                  <div class="w-6 h-6 rounded bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-purple-600 dark:text-purple-400">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
                    </svg>
                  </div>
                  <p class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100 leading-tight">Industry Event</p>
                  <p class="text-[9px] text-neutral-500 font-mono">Representing Oleria</p>
                </div>
              )}

              {slide.type === 'meetup' && (
                <div class="space-y-1">
                  <div class="w-6 h-6 rounded bg-emerald-50 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <p class="text-[11px] font-bold text-neutral-900 dark:text-neutral-100 leading-tight">Community Talk</p>
                  <p class="text-[9px] text-neutral-500 font-mono">NHI Security</p>
                </div>
              )}
            </div>

            <p class="text-[9px] font-mono text-neutral-400 truncate">Abhishek Singh</p>
          </>
        )}
      </div>

          <!-- Slide Content & Link to About Section -->
          <div class="flex-1 space-y-2 text-left">
            <div>
              <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">{slide.tag}</span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 leading-snug">
                {slide.title}
              </h3>
            </div>
            <p class="text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed">
              {slide.subtitle}
            </p>
            <div class="pt-2">
              <a 
                href={slide.href} 
                class="inline-flex items-center gap-1 text-xs text-neutral-900 dark:text-neutral-100 underline decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-black dark:hover:decoration-white font-medium"
              >
                {slide.linkText}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <p class="text-[11px] text-neutral-400 dark:text-neutral-500 text-right font-mono">
    + other community talks and meetups
  </p>
</div>

<script>
  let carouselController: AbortController | null = null;

  function setupCarousel() {
    carouselController?.abort();
    carouselController = new AbortController();
    const { signal } = carouselController;

    let currentSlide = 0;
    const totalSlides = 4;

    const track = document.getElementById('carousel-track');
    const counter = document.getElementById('carousel-current');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');

    function updateCarousel() {
      if (track) {
        track.style.transform = `translateX(-${currentSlide * 100}%)`;
      }
      if (counter) {
        counter.textContent = (currentSlide + 1).toString();
      }
    }

    prevBtn?.addEventListener('click', () => {
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      updateCarousel();
    }, { signal });

    nextBtn?.addEventListener('click', () => {
      currentSlide = (currentSlide + 1) % totalSlides;
      updateCarousel();
    }, { signal });
  }

  document.addEventListener('astro:page-load', setupCarousel);
</script>
