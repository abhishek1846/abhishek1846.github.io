---
const links = [
  { name: 'linkedin', url: 'https://linkedin.com/in/abhishek1846' },
];
---

<footer class="mt-20 pt-8 border-t border-neutral-100 dark:border-neutral-900 flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500">
  <div class="flex items-center space-x-4">
    {links.map((link) => (
      <a 
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors duration-200"
      >
        {link.name} ↗
      </a>
    ))}
  </div>
</footer>
