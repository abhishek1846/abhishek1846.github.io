---
const highlights = [
  {
    tag: "National Publication",
    title: "Identity Security in the AI Era",
    subtitle: "Co-authored with DSCI (Data Security Council of India)",
    linkText: "Read paper on DSCI ↗",
    href: "https://www.dsci.in/resource/content/identity-security-maturity-ai-era",
  },
  {
    tag: "Industry Conference",
    title: "Gartner Security & Risk Management Summit",
    subtitle: "Represented Oleria in conversations on identity governance and AI security.",
  },
  {
    tag: "Identity Conference",
    title: "Identiverse",
    subtitle: "Represented Oleria at the identity security conference.",
  },
  {
    tag: "Community Meetup",
    title: "IAM Meetup: Non-Human Identity Security",
    subtitle: "A talk on securing non-human identities and machine credentials.",
  },
];
---

<div class="space-y-4">
  <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 pb-2 border-b border-neutral-100 dark:border-neutral-900">
    Publications, Conferences & Meetups
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {highlights.map((item) => (
      <article class="min-w-0 rounded-lg border border-neutral-200 dark:border-neutral-800 p-4">
        <p class="text-xs text-neutral-500 dark:text-neutral-400">{item.tag}</p>
        <h3 class="mt-1.5 text-sm font-medium text-neutral-900 dark:text-neutral-100 leading-snug">
          {item.title}
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-neutral-600 dark:text-neutral-400">{item.subtitle}</p>
        {'href' in item && (
          <a href={item.href} class="mt-3 inline-block text-xs text-neutral-600 dark:text-neutral-300 underline underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500">
            {item.linkText}
          </a>
        )}
      </article>
    ))}
  </div>
</div>
