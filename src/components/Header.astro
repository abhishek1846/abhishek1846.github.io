---
interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const tabs = [
  { name: 'home', href: '/', key: '1' },
  { name: 'writing', href: '/writing', key: '2' },
  { name: 'work', href: '/work', key: '3' },
  { name: 'projects', href: '/projects', key: '4' },
  { name: 'books', href: '/books', key: '5' },
  { name: 'uses', href: '/uses', key: '6' },
  { name: 'about', href: '/about', key: '7' },
];
---

<header class="sticky top-0 z-50 bg-white/90 dark:bg-[#090a0f]/90 backdrop-blur-md pt-5 pb-4 mb-10 border-b border-neutral-200/80 dark:border-neutral-800/80 transition-colors">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <!-- Brand / Name -->
    <a href="/" class="text-sm font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 hover:opacity-80 transition-opacity flex items-center gap-2">
      <span>Abhishek Singh</span>
      <span class="text-[11px] font-mono text-neutral-400 font-normal">/ PM & Builder</span>
    </a>

    <!-- Top Persistent Navigation Tabs -->
    <div class="flex items-center justify-between sm:justify-end gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar py-0.5">
      <nav class="flex items-center gap-1 sm:gap-1.5 text-xs">
        {tabs.map((tab) => {
          const isActive = current === tab.name;
          return (
            <a 
              href={tab.href}
              class={`px-2.5 py-1 rounded-md transition-all flex items-center gap-1.5 group ${
                isActive 
                  ? 'bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 font-medium shadow-xs' 
                  : 'text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800/60'
              }`}
              title={`Press ${tab.key} to visit ${tab.name}`}
            >
              <span>{tab.name}</span>
              <kbd class={`hidden md:inline-block text-[9px] font-mono rounded px-1 ${
                isActive 
                  ? 'bg-neutral-800 text-neutral-300 dark:bg-neutral-200 dark:text-neutral-700' 
                  : 'text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-700 dark:group-hover:text-neutral-300'
              }`}>
                {tab.key}
              </kbd>
            </a>
          );
        })}
      </nav>

      <div class="h-4 w-px bg-neutral-200 dark:bg-neutral-800 mx-1 shrink-0"></div>

      <!-- Theme Toggle -->
      <button 
        id="theme-toggle"
        aria-label="Toggle Theme"
        onclick="window.toggleTheme()"
        class="p-1.5 rounded-md text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 hover:bg-neutral-100 dark:hover:bg-neutral-800/60 transition-colors shrink-0"
      >
        <svg class="w-3.5 h-3.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="w-3.5 h-3.5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
    </div>
  </div>
</header>
