---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About | Abhishek Singh"
  description="Background, story, publications, conferences, and meetups of Abhishek Singh."
>
  <Header current="about" />

  <main class="space-y-12">
    <!-- Bio Intro with Download Resume Button -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          About Me
        </h1>

        <a 
          href="/resume.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 text-xs font-medium hover:opacity-90 transition-opacity shrink-0 w-fit"
        >
          <span>Download Full Resume (PDF)</span>
          <span>↗</span>
        </a>
      </div>

      <p class="text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
        I am a Staff Product Manager and two-time former founder with 9 years of experience across enterprise security, agentic AI, and data platforms.
      </p>
    </div>

    <!-- Career Trajectory Narrative -->
    <section class="space-y-4 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-2">
        My Story
      </h2>

      <p>
        I graduated from <span class="text-neutral-900 dark:text-white font-medium">IIT (BHU), Varanasi</span>. I started my career in decision analytics at <span class="text-neutral-900 dark:text-white font-medium">ZS Associates</span>, working with Fortune 500 US clients on data modeling and market strategy.
      </p>

      <p>
        Drawn to fast-paced consumer and B2B software, I joined <span class="text-neutral-900 dark:text-white font-medium">PharmEasy</span>, where I owned product for <span class="text-neutral-900 dark:text-white font-medium">Docon</span> (scaling digital prescriptions to ~1M/month) and pharmaceutical enterprise analytics.
      </p>

      <p>
        Later, I took the jump into full-time entrepreneurship: co-founding <strong class="text-neutral-900 dark:text-white">Dashh</strong> (1-click checkout engine for e-commerce brands), and subsequently co-founding <strong class="text-neutral-900 dark:text-white">Komma</strong> as CEO (collaborative analytics notebooks for modern data teams; interviewed 150+ data leaders, raised a Pre-Seed round, and closed 6 enterprise PoCs).
      </p>

      <p>
        After leading product growth for <span class="text-neutral-900 dark:text-white font-medium">Kloudfuse</span> in India, I joined <span class="text-neutral-900 dark:text-white font-medium">Oleria</span> as Staff Product Manager. Today, I lead product across ~30 engineers for our Non-Human Identity (NHI) and autonomous AI Agent Governance platform.
      </p>
    </section>

    <!-- Work Highlights -->
    <section class="space-y-4">
      <div class="pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Work Highlights
        </h2>
      </div>

      <div class="space-y-3 text-sm">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Oleria</span>
            <span class="text-neutral-500 text-xs"> - Staff Product Manager (NHI & AI Governance)</span>
          </div>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 font-medium">Current</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Komma</span>
            <span class="text-neutral-500 text-xs"> - Co-Founder & CEO (Analytics notebooks)</span>
          </div>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Dashh</span>
            <span class="text-neutral-500 text-xs"> - Co-Founder (1-click checkout)</span>
          </div>
        </div>

        <div class="pt-2 border-t border-neutral-100 dark:border-neutral-900">
          <p class="text-xs text-neutral-500 leading-relaxed">
            Other past roles include product growth at <span class="font-medium text-neutral-800 dark:text-neutral-200">Kloudfuse</span>, product for Docon at <span class="font-medium text-neutral-800 dark:text-neutral-200">PharmEasy</span>, and decision analytics at <span class="font-medium text-neutral-800 dark:text-neutral-200">ZS Associates</span>.
          </p>
        </div>
      </div>
    </section>

    <!-- Talks, Publications & Gallery (Linked from Home Carousel) -->
    <section id="gallery" class="space-y-6">
      <div class="pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Publications, Conferences & Meetups
        </h2>
        <p class="text-xs text-neutral-500 mt-1">
          Moments from security conferences, community meetups, and national research publications.
        </p>
      </div>

      <div class="space-y-6">
        <!-- DSCI Paper -->
        <article id="dsci-paper" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30">
          <div class="flex flex-col sm:flex-row gap-5 items-start">
            <a 
              href="https://www.dsci.in/resource/content/identity-security-maturity-ai-era" 
              target="_blank" 
              rel="noopener noreferrer"
              class="shrink-0 rounded-lg overflow-hidden border border-neutral-200 dark:border-neutral-800 shadow-xs hover:opacity-90 transition-opacity"
            >
              <img 
                src="/images/dsci-paper-thumb.webp" 
                alt="Identity Security Maturity in the AI Era - DSCI" 
                class="w-24 sm:w-28 h-auto object-cover rounded-lg"
                loading="lazy"
              />
            </a>

            <div class="space-y-3 flex-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <div>
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 font-medium border border-blue-200 dark:border-blue-900/40">
                    National Whitepaper
                  </span>
                  <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                    Identity Security Maturity in the AI Era
                  </h3>
                </div>
                <span class="text-xs font-mono text-neutral-400">Data Security Council of India (DSCI) • 2026</span>
              </div>

              <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
                Co-authored the national industry benchmark paper with DSCI, providing CISOs and enterprise security architects with an actionable maturity model for governing autonomous AI agents, non-human identities, and machine-to-machine trust perimeters.
              </p>

              <div class="pt-1">
                <a 
                  href="https://www.dsci.in/resource/content/identity-security-maturity-ai-era" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-xs font-medium text-neutral-900 dark:text-neutral-100 underline decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-black dark:hover:decoration-white"
                >
                  Read Whitepaper on DSCI Website ↗
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- Gartner SRM -->
        <article id="conf-gartner-srm" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 font-medium border border-purple-200 dark:border-purple-900/40">
                Industry Conference
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                Gartner Security & Risk Management Summit
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Representing Oleria</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Represented Oleria at the Gartner Security & Risk Management Summit. Engaged directly with enterprise security leaders, CISOs, and practitioners on non-human identity governance and managing AI risk.
          </p>
        </article>

        <!-- Identiverse -->
        <article id="conf-identiverse" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 font-medium border border-purple-200 dark:border-purple-900/40">
                Identity Conference
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                Identiverse
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Representing Oleria</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Represented Oleria at Identiverse. Connected with the broader identity security ecosystem to discuss machine-to-machine trust, API token governance, and modern IAM architecture.
          </p>
        </article>

        <!-- IAM Meetup Talk -->
        <article id="meetup-iam-nhi" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-medium border border-emerald-200 dark:border-emerald-900/40">
                Community Talk
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                IAM Meetup: Non-Human Identity Security
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Speaker</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Gave a talk on Non-Human Identity (NHI) security at an IAM meetup. Discussed how service accounts, tokens, and autonomous AI agents expand enterprise blast radius, and shared practical ways teams can govern them.
          </p>
        </article>

        <!-- Subtle Note for Other Meetups -->
        <p class="text-xs text-neutral-400 dark:text-neutral-500 pt-1 font-mono italic">
          + other community talks and meetups.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
