---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About | Abhishek Singh"
  description="Background, story, publications, and conference talks of Abhishek Singh."
>
  <Header current="about" />

  <main class="space-y-12">
    <!-- Bio Intro -->
    <div class="space-y-3">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        About Me
      </h1>
      <p class="text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
        I am a Staff Product Manager and two-time former founder with over 8 years of experience building products across enterprise security, agentic AI, developer platforms, and high-growth consumer technology.
      </p>
    </div>

    <!-- Career Trajectory Narrative -->
    <section class="space-y-4 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-2">
        My Story
      </h2>

      <p>
        I graduated from <span class="text-neutral-900 dark:text-white font-medium">IIT (BHU), Varanasi</span>. I started my career in decision analytics at <span class="text-neutral-900 dark:text-white font-medium">ZS Associates</span>, working with Fortune 500 US clients on data modeling and market strategy.
      </p>

      <p>
        Drawn to fast-paced consumer and B2B software, I joined <span class="text-neutral-900 dark:text-white font-medium">PharmEasy</span>, where I owned product for <span class="text-neutral-900 dark:text-white font-medium">Docon</span> (scaling digital prescriptions to ~1M/month) and pharmaceutical enterprise analytics.
      </p>

      <p>
        Later, I took the jump into full-time entrepreneurship: co-founding <strong class="text-neutral-900 dark:text-white">Dashh</strong> (1-click checkout engine for e-commerce brands, turned down 2 acquihire offers), and subsequently co-founding <strong class="text-neutral-900 dark:text-white">Komma</strong> as CEO (collaborative analytics notebooks for modern data teams; interviewed 150+ data leaders, raised a Pre-Seed round, closed 6 enterprise PoCs, and led the team through acquisition by a Series A fintech).
      </p>

      <p>
        After helping expand <span class="text-neutral-900 dark:text-white font-medium">Kloudfuse</span>'s presence and GTM in India, I joined <span class="text-neutral-900 dark:text-white font-medium">Oleria</span> as Staff Product Manager. Today, I lead product across ~30 engineers for our Non-Human Identity (NHI) and autonomous AI Agent Governance platform.
      </p>
    </section>

    <!-- Work Highlights & Resume PDF link -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Work Highlights
        </h2>
        <a 
          href="/resume.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-xs font-mono text-neutral-900 dark:text-neutral-100 hover:text-blue-600 dark:hover:text-blue-400 underline decoration-neutral-300 dark:decoration-neutral-700 transition-colors"
        >
          Full Resume (PDF) ↗
        </a>
      </div>

      <div class="space-y-3 text-sm">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Oleria</span>
            <span class="text-neutral-500 text-xs"> — Staff Product Manager (NHI & AI Governance)</span>
          </div>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 font-medium">Current</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Komma</span>
            <span class="text-neutral-500 text-xs"> — Co-Founder & CEO (Analytics notebooks)</span>
          </div>
          <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">Acquired</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Dashh</span>
            <span class="text-neutral-500 text-xs"> — Co-Founder (1-click checkout)</span>
          </div>
        </div>

        <div class="pt-2 border-t border-neutral-100 dark:border-neutral-900">
          <p class="text-xs text-neutral-500 leading-relaxed">
            Other past roles include leading India GTM at <span class="font-medium text-neutral-800 dark:text-neutral-200">Kloudfuse</span>, product for Docon at <span class="font-medium text-neutral-800 dark:text-neutral-200">PharmEasy</span>, and decision analytics at <span class="font-medium text-neutral-800 dark:text-neutral-200">ZS Associates</span>.
          </p>
        </div>
      </div>
    </section>

    <!-- Talks, Publications & Gallery (Linked from Home Carousel) -->
    <section id="gallery" class="space-y-6">
      <div class="pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Publications, Talks & Meetups
        </h2>
        <p class="text-xs text-neutral-500 mt-1">
          Moments from security conferences, community meetups, and national research publications.
        </p>
      </div>

      <div class="space-y-6">
        <!-- DSCI Paper -->
        <article id="dsci-paper" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 font-medium border border-blue-200 dark:border-blue-900/40">
                National Whitepaper
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                Identity Security Maturity in the AI Era
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Data Security Council of India (DSCI) • 2026</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Co-authored the national industry benchmark paper with DSCI, providing CISOs and enterprise security architects with an actionable maturity model for governing autonomous AI agents, non-human identities, and machine-to-machine trust perimeters.
          </p>
          <div class="pt-1">
            <a 
              href="https://www.dsci.in/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-xs font-medium text-neutral-900 dark:text-neutral-100 underline decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-black dark:hover:decoration-white"
            >
              View on DSCI Website ↗
            </a>
          </div>
        </article>

        <!-- Conference 1 -->
        <article id="conf-identity-summit" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 font-medium border border-purple-200 dark:border-purple-900/40">
                Keynote Talk
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                Enterprise Identity World 2026
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Keynote Speaker</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Delivered a keynote on the explosion of Non-Human Identities (NHIs) and how autonomous AI agents like Salesforce Agentforce and Gemini Enterprise are reshaping IAM access reviews and permission graphs.
          </p>
        </article>

        <!-- Conference 2 -->
        <article id="conf-cloud-sec" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 font-medium border border-purple-200 dark:border-purple-900/40">
                Panel Discussion
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                Global Cloud Security Summit
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Panelist</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Joined a panel of enterprise security leaders to discuss governing service accounts across AWS, GCP, and Azure, and the operational reality of moving away from static API secrets.
          </p>
        </article>

        <!-- Meetup 1 -->
        <article id="meetup-bengaluru" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-medium border border-emerald-200 dark:border-emerald-900/40">
                Community Meetup
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                Bengaluru Identity Security Meetup
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Speaker & Host</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Presented a live technical walkthrough demonstrating how Model Context Protocol (MCP) servers can query an identity context graph to answer real-time enterprise security inquiries in natural language.
          </p>
        </article>

        <!-- Meetup 2 -->
        <article id="meetup-builders" class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 font-medium border border-emerald-200 dark:border-emerald-900/40">
                Developer Meetup
              </span>
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 mt-1.5">
                Security Builders & Founders Meetup
              </h3>
            </div>
            <span class="text-xs font-mono text-neutral-400">Bengaluru</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            Shared war stories from founding two startups (Dashh and Komma), navigating the acquisition process, and translating founder velocity into Staff PM leadership at enterprise scale.
          </p>
        </article>
      </div>
    </section>

    <!-- Connect -->
    <section class="space-y-3 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed pt-4 border-t border-neutral-100 dark:border-neutral-900">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
        Get In Touch
      </h2>
      <p>
        Always happy to chat about identity security, AI agents, 0-to-1 startups, or book recommendations:
      </p>
      <div class="flex items-center gap-4 text-xs font-mono pt-1">
        <a href="https://linkedin.com/in/abhishek1846" target="_blank" rel="noopener noreferrer" class="text-neutral-900 dark:text-white underline hover:opacity-80">
          LinkedIn ↗
        </a>
        <span>•</span>
        <a href="https://github.com/abhisheksingh0196" target="_blank" rel="noopener noreferrer" class="text-neutral-900 dark:text-white underline hover:opacity-80">
          GitHub ↗
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
