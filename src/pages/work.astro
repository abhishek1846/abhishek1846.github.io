---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Work & Journey | Abhishek Singh"
  description="Career timeline, leadership roles, and entrepreneurial journey of Abhishek Singh."
>
  <Header current="work" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Work & Experience
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        Over 8 years bridging deep technical infrastructure, 0-to-1 entrepreneurship, and enterprise SaaS product leadership.
      </p>
    </div>

    <!-- Career Timeline -->
    <div class="space-y-10 border-l border-neutral-200 dark:border-neutral-800 pl-6 ml-2">
      <!-- Oleria -->
      <div class="relative space-y-2">
        <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-blue-600 ring-4 ring-white dark:ring-[#090a0f]"></span>
        
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <div>
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-1.5">
              <span>Staff Product Manager — Oleria</span>
              <a href="https://oleria.com" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">↗</a>
            </h2>
            <p class="text-xs text-neutral-500 font-mono">Senior PM (May 2025) → Staff PM (Aug 2025 — Present)</p>
          </div>
          <span class="text-xs font-mono text-neutral-400">Bengaluru, India</span>
        </div>

        <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed pt-1">
          First Product Manager in India; sole PM across a ~30-engineer organization. Spearheading Non-Human Identity (NHI) & AI agent governance across Gemini Enterprise, Salesforce Agentforce, and AWS Bedrock.
        </p>

        <ul class="text-xs text-neutral-600 dark:text-neutral-400 space-y-1.5 list-disc pl-4 leading-relaxed">
          <li>Drove $3M in net-new enterprise PoCs by repositioning product conversations around autonomous agent and NHI governance.</li>
          <li>Built AI agent governance: continuous discovery of dynamic agents mapped to identity graphs with automated reviews.</li>
          <li>Scaled Oleria's integration catalog from 20 to 100+ connected enterprise applications.</li>
          <li>Led development of Workflow Studio and Integration Studio, enabling self-serve customer automation.</li>
        </ul>
      </div>

      <!-- Kloudfuse -->
      <div class="relative space-y-2">
        <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 ring-4 ring-white dark:ring-[#090a0f]"></span>

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <div>
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-1.5">
              <span>Product & Growth Lead, India — Kloudfuse</span>
              <a href="https://kloudfuse.com" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">↗</a>
            </h2>
            <p class="text-xs text-neutral-500 font-mono">Apr 2024 — May 2025</p>
          </div>
          <span class="text-xs font-mono text-neutral-400">Bengaluru, India</span>
        </div>

        <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed pt-1">
          Opened the India market for enterprise observability; onboarded marquee customers including 1mg, Innovacer, and GE Health.
        </p>
        <ul class="text-xs text-neutral-600 dark:text-neutral-400 space-y-1.5 list-disc pl-4 leading-relaxed">
          <li>Led the launch of Real User Monitoring (RUM) and core platform analytics updates.</li>
          <li>Grew the India team from 4 to 8 engineers and solutions architects.</li>
        </ul>
      </div>

      <!-- Komma -->
      <div class="relative space-y-2">
        <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-white dark:ring-[#090a0f]"></span>

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <div>
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
              <span>Co-Founder & CEO — Komma</span>
              <span class="text-[10px] font-mono font-normal px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">Acquired</span>
            </h2>
            <p class="text-xs text-neutral-500 font-mono">Jan 2023 — Feb 2024</p>
          </div>
          <span class="text-xs font-mono text-neutral-400">Bengaluru / Remote</span>
        </div>

        <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed pt-1">
          Built a collaborative analytics notebook for modern data teams. Conducted 150+ user interviews with data leaders from companies like Twilio, United Airlines, and Athelas.
        </p>
        <ul class="text-xs text-neutral-600 dark:text-neutral-400 space-y-1.5 list-disc pl-4 leading-relaxed">
          <li>Closed 6 enterprise PoC customers and raised a $150K Pre-Seed / Angel round.</li>
          <li>Team acquired by a Series A fintech in March 2024.</li>
        </ul>
      </div>

      <!-- Dashh -->
      <div class="relative space-y-2">
        <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 ring-4 ring-white dark:ring-[#090a0f]"></span>

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <div>
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
              Co-Founder — Dashh
            </h2>
            <p class="text-xs text-neutral-500 font-mono">Dec 2021 — Dec 2022</p>
          </div>
          <span class="text-xs font-mono text-neutral-400">Bengaluru, India</span>
        </div>

        <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed pt-1">
          Built a 1-click checkout solution for e-commerce merchants in 2.5 months with 2 engineers. Onboarded 10 brands, optimized UX and conversion performance, and turned down 2 acquihire offers to pursue building.
        </p>
      </div>

      <!-- PharmEasy -->
      <div class="relative space-y-2">
        <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 ring-4 ring-white dark:ring-[#090a0f]"></span>

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <div>
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-1.5">
              <span>Senior Product Manager — PharmEasy</span>
              <a href="https://pharmeasy.in" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">↗</a>
            </h2>
            <p class="text-xs text-neutral-500 font-mono">Nov 2018 — Nov 2021</p>
          </div>
          <span class="text-xs font-mono text-neutral-400">Bengaluru, India</span>
        </div>

        <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed pt-1">
          Owned product for Docon, a digital prescription platform scaled to ~1M prescriptions per month, driving downstream e-pharmacy and diagnostics growth.
        </p>
        <ul class="text-xs text-neutral-600 dark:text-neutral-400 space-y-1.5 list-disc pl-4 leading-relaxed">
          <li>Led doctor-facing prescription analytics and enterprise pharmaceutical dashboards.</li>
          <li>Transitioned from Data Analyst to Product Manager, building analytical capabilities from the ground up.</li>
        </ul>
      </div>

      <!-- ZS Associates -->
      <div class="relative space-y-2">
        <span class="absolute -left-[31px] top-1.5 w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-neutral-700 ring-4 ring-white dark:ring-[#090a0f]"></span>

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
          <div>
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
              Decision Analytics Associate — ZS Associates
            </h2>
            <p class="text-xs text-neutral-500 font-mono">Jun 2017 — Oct 2018</p>
          </div>
          <span class="text-xs font-mono text-neutral-400">Pune, India</span>
        </div>

        <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed pt-1">
          Selected for the Priority Industries division to lead new data analytics initiatives for US Fortune 500 clients. Sole first-year associate selected to conduct analytics training for new cohorts.
        </p>
      </div>
    </div>

    <!-- Education & Publications Box -->
    <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-3">
      <h3 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
        Education & Publications
      </h3>
      <div class="text-sm text-neutral-700 dark:text-neutral-300 space-y-2">
        <div class="flex justify-between items-baseline">
          <p class="font-medium text-neutral-900 dark:text-white">IIT (BHU), Varanasi</p>
          <span class="text-xs font-mono text-neutral-400">2012 — 2017</span>
        </div>
        <p class="text-xs text-neutral-500">
          Co-author of <span class="italic font-medium text-neutral-800 dark:text-neutral-200">"Identity Security Maturity in the AI Era"</span> with the Data Security Council of India (DSCI).
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
