---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const roles = [
  {
    company: "Oleria",
    role: "Staff Product Manager",
    period: "2025 — Present",
    url: "https://oleria.com",
    highlight: "Leading product for Non-Human Identity (NHI) and AI Agent Governance across 30+ engineers. Scaled integrations from 20 to 100+ apps and drove $3M in new enterprise PoCs.",
  },
  {
    company: "Kloudfuse",
    role: "Product & Growth Lead, India",
    period: "2024 — 2025",
    url: "https://kloudfuse.com",
    highlight: "Opened the India market for enterprise observability; onboarded 1mg, Innovacer, and GE Health. Led Real User Monitoring (RUM) launch.",
  },
  {
    company: "Komma",
    role: "Co-Founder & CEO",
    period: "2022 — 2024",
    tag: "Acquired",
    highlight: "Collaborative analytics notebooks for data teams. Conducted 150+ data leader interviews, closed 6 PoCs, raised Pre-Seed round. Acquired by Series A fintech in March 2024.",
  },
  {
    company: "Dashh",
    role: "Co-Founder",
    period: "2021 — 2022",
    highlight: "Built 1-click checkout platform for e-commerce in 2.5 months with 2 engineers; live on 10 brands, received 2 acquihire offers.",
  },
  {
    company: "PharmEasy",
    role: "Senior Product Manager",
    period: "2018 — 2021",
    url: "https://pharmeasy.in",
    highlight: "Owned product for Docon digital prescriptions (~1M Rx/month). Built doctor-facing analytics and pharmaceutical data dashboards.",
  },
  {
    company: "ZS Associates",
    role: "Decision Analytics Associate",
    period: "2017 — 2018",
    highlight: "Decision analytics for US Fortune 500 clients. Selected for Priority Industries division and cohort training lead.",
  },
];
---

<Layout 
  title="Work | Abhishek Singh"
  description="Career highlights and resume of Abhishek Singh."
>
  <Header current="work" />

  <main class="space-y-10">
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 pb-2 border-b border-neutral-100 dark:border-neutral-900">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          Work Highlights
        </h1>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
          Brief summary of roles. For detailed metrics and squad history, view the full PDF.
        </p>
      </div>

      <a 
        href="/resume.pdf" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 text-xs font-medium hover:opacity-90 transition-opacity shrink-0 w-fit"
      >
        <span>Download Full Resume (PDF)</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Clean, non-duplicative work highlights -->
    <div class="divide-y divide-neutral-100 dark:divide-neutral-900">
      {roles.map((item) => (
        <div class="py-5 first:pt-0 space-y-1.5">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
              <span>{item.company}</span>
              <span class="text-xs text-neutral-400 font-normal font-mono">— {item.role}</span>
              {item.tag && (
                <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                  {item.tag}
                </span>
              )}
              {item.url && (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors">↗</a>
              )}
            </h2>
            <span class="text-xs font-mono text-neutral-400 shrink-0">{item.period}</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {item.highlight}
          </p>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
