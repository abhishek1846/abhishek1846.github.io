---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Work | Abhishek Singh"
  description="Product leadership, founder stints, and engineering background of Abhishek Singh."
>
  <Header current="work" />

  <main class="space-y-12">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 pb-2 border-b border-neutral-100 dark:border-neutral-900">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
          Work & Experience
        </h1>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
          Product leadership, 0-to-1 startup craft, and technical platform execution.
        </p>
      </div>

      <a 
        href="/resume.pdf" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 text-xs font-medium hover:opacity-90 transition-opacity shrink-0 w-fit"
      >
        <span>Full Resume (PDF)</span>
        <span>↗</span>
      </a>
    </div>

    <!-- Section 1: Current Leadership Role -->
    <section class="space-y-4">
      <div class="flex items-center gap-2">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Current Focus
        </h2>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      </div>

      <div class="p-6 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-3">
        <div class="flex items-baseline justify-between">
          <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
            <span>Oleria</span>
            <span class="text-xs font-normal text-neutral-400 font-mono">— Staff Product Manager</span>
            <a href="https://oleria.com" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-black dark:hover:text-white transition-colors">↗</a>
          </h3>
        </div>

        <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
          Leading product across ~30 engineers for <span class="font-medium text-neutral-900 dark:text-white">Non-Human Identity (NHI) and autonomous AI Agent Governance</span>. Shaping how Fortune 500 enterprises discover, map, and govern autonomous agents (Gemini Enterprise, Salesforce Agentforce, AWS Bedrock) and machine credentials.
        </p>

        <ul class="text-xs text-neutral-600 dark:text-neutral-400 space-y-1.5 list-disc pl-4 leading-relaxed">
          <li>Drove $3M in net-new enterprise PoCs by repositioning product conversations around autonomous agent and NHI governance.</li>
          <li>Scaled Oleria's integration catalog from 20 to 100+ connected applications.</li>
          <li>Led development of Workflow Studio and Integration Studio, enabling self-serve customer automation.</li>
          <li>Shaped the Oleria MCP (Model Context Protocol) AI experience for querying context graphs on enterprise data.</li>
        </ul>
      </div>
    </section>

    <!-- Section 2: Founder Experience -->
    <section class="space-y-4">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-2">
        Founder Stints
      </h2>

      <div class="space-y-6">
        <!-- Komma -->
        <div class="space-y-2">
          <div class="flex items-baseline justify-between">
            <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
              <span>Komma</span>
              <span class="text-xs text-neutral-400 font-normal font-mono">— Co-Founder & CEO</span>
              <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                Acquired
              </span>
            </h3>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Built collaborative analytics notebooks for modern data teams. Conducted 150+ user interviews with data leaders from companies like Twilio, United Airlines, and Athelas. Closed 6 enterprise PoC customers, raised a Pre-Seed / Angel round, and led the team through acquisition by a Series A fintech.
          </p>
        </div>

        <!-- Dashh -->
        <div class="space-y-2">
          <div class="flex items-baseline justify-between">
            <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
              <span>Dashh</span>
              <span class="text-xs text-neutral-400 font-normal font-mono">— Co-Founder</span>
            </h3>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Built a 1-click checkout solution for e-commerce merchants in 2.5 months with 2 engineers. Onboarded 10 brands, optimized UX and conversion performance, and received 2 acquihire offers before deciding to build independently.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Other Involvements (No Timelines) -->
    <section class="space-y-4">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-100 dark:border-neutral-900 pb-2">
        Other Past Involvements
      </h2>

      <div class="space-y-4 text-sm">
        <div class="space-y-1">
          <div class="flex items-baseline gap-2">
            <span class="font-semibold text-neutral-900 dark:text-neutral-100">Kloudfuse</span>
            <span class="text-xs text-neutral-400 font-mono">— Product & Growth Lead, India</span>
            <a href="https://kloudfuse.com" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-black dark:hover:text-white transition-colors">↗</a>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Opened India presence for unified enterprise observability; onboarded marquee customers including 1mg, Innovacer, and GE Health, and led the launch of Real User Monitoring (RUM).
          </p>
        </div>

        <div class="space-y-1">
          <div class="flex items-baseline gap-2">
            <span class="font-semibold text-neutral-900 dark:text-neutral-100">PharmEasy</span>
            <span class="text-xs text-neutral-400 font-mono">— Senior Product Manager</span>
            <a href="https://pharmeasy.in" target="_blank" rel="noopener noreferrer" class="text-xs text-neutral-400 hover:text-black dark:hover:text-white transition-colors">↗</a>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Owned product for Docon digital prescriptions (~1M prescriptions/month), leading doctor-facing analytics and pharmaceutical enterprise data dashboards.
          </p>
        </div>

        <div class="space-y-1">
          <div class="flex items-baseline gap-2">
            <span class="font-semibold text-neutral-900 dark:text-neutral-100">ZS Associates</span>
            <span class="text-xs text-neutral-400 font-mono">— Decision Analytics Associate</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Worked with US Fortune 500 enterprise clients on decision analytics, commercial market strategy, and data modeling.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
