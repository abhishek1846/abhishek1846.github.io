---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(date);
};
---

<Layout 
  title="Writing | Abhishek Singh"
  description="Essays and notes on identity security, non-human identities, agentic AI, product management, and building tools."
>
  <Header current="writing" />

  <main class="space-y-8">
    <div class="space-y-2 pb-2 border-b border-neutral-100 dark:border-neutral-900">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Writing
      </h1>
      <p class="text-xs text-neutral-500 dark:text-neutral-400">
        Essays on identity security, autonomous AI agents, and building unbloated software.
      </p>
    </div>

    <!-- Clean, minimal list: just title and date -->
    <div class="space-y-4">
      {posts.map((post) => (
        <article class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 group py-1">
          <a 
            href={`/writing/${post.id}`} 
            class="text-sm font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors underline decoration-neutral-200 dark:decoration-neutral-800 group-hover:decoration-blue-500"
          >
            {post.data.title}
          </a>
          <span class="text-xs font-mono text-neutral-400 shrink-0">
            {formatDate(post.data.pubDate)}
          </span>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
