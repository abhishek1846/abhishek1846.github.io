---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing')).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0)
);
---

<Layout 
  title="Writing | Abhishek Singh"
  description="Essays, notes, and observations on software, reading, and life by Abhishek Singh."
>
  <Header current="writing" />

  <main class="space-y-8">
    <div class="space-y-2 pb-2 border-b border-neutral-100 dark:border-neutral-900">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Writing
      </h1>
      <p class="text-xs text-neutral-500 dark:text-neutral-400">
        Essays, notes, and observations on software, reading, and life.
      </p>
    </div>

    <!-- Clean, minimal list: just title -->
    <div class="space-y-3">
      {posts.map((post) => (
        <article class="py-1">
          <a 
            href={`/writing/${post.id}`} 
            class="text-sm font-medium text-neutral-800 dark:text-neutral-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors underline decoration-neutral-200 dark:decoration-neutral-800 hover:decoration-blue-500"
          >
            {post.data.title}
          </a>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
