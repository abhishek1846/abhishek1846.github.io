---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(date);
};
---

<Layout 
  title="Writing | Abhishek Singh"
  description="Essays and notes on identity security, non-human identities, agentic AI, product management, and building tools."
>
  <Header current="writing" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Writing & Thoughts
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        Essays on non-human identity security, autonomous AI agents, 0-to-1 product development, and building minimalist software.
      </p>
    </div>

    <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
      {posts.map((post) => (
        <article class="py-6 first:pt-2 group">
          <a href={`/writing/${post.id}`} class="block space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h2 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h2>
              <span class="text-xs font-mono text-neutral-400 shrink-0">
                {formatDate(post.data.pubDate)}
              </span>
            </div>
            
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {post.data.description}
            </p>

            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 pt-1">
                {post.data.tags.map((tag) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
