---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout 
  title={`${post.data.title} | Abhishek Singh`}
  description={post.data.description}
>
  <Header current="writing" />

  <main class="space-y-8">
    <!-- Back button -->
    <a 
      href="/writing" 
      class="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
    >
      ← Back to all essays
    </a>

    <!-- Header info -->
    <header class="pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 leading-tight">
        {post.data.title}
      </h1>
    </header>

    <!-- Post Content -->
    <article class="markdown-content">
      <Content />
    </article>
  </main>

  <Footer />
</Layout>
