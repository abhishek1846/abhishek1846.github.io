---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const books = [
  {
    title: "A Fine Balance",
    author: "Rohinton Mistry",
    genre: "Literature / Fiction",
    status: "Reading",
    notes: "A sprawling, heartbreaking masterpiece about human dignity, unlikely friendship, and resilience during the Emergency in India.",
  },
  {
    title: "The Myth of Sisyphus",
    author: "Albert Camus",
    genre: "Philosophy",
    status: "Completed",
    notes: "A fundamental philosophical inquiry into absurdism, freedom, and the necessity of finding meaning and revolt in everyday existence.",
  },
  {
    title: "Amusing Ourselves to Death",
    author: "Neil Postman",
    genre: "Media & Culture",
    status: "Completed",
    notes: "Prophetic critique of how medium shapes discourse. Even more relevant in the age of algorithmic feeds and short-form video than when it was written in 1985.",
  },
  {
    title: "The Evolution of Everything: How New Ideas Emerge",
    author: "Matt Ridley",
    genre: "Economics & Science",
    status: "Completed",
    notes: "Argues that top-down design is an illusion—culture, technology, language, and institutions evolve bottom-up organically through spontaneous order.",
  },
  {
    title: "Piranesi",
    author: "Susanna Clarke",
    genre: "Speculative Fiction",
    status: "Completed",
    notes: "An ethereal, quiet exploration of wonder, isolation, and innocence set inside an infinite House of labyrinthine halls and ocean tides.",
  },
  {
    title: "Stiff: The Curious Lives of Human Cadavers",
    author: "Mary Roach",
    genre: "Science / History",
    status: "Completed",
    notes: "Macabre yet strangely reverent and witty exploration of what happens to the human body when donated to science across centuries.",
  },
];
---

<Layout 
  title="Books & Reading | Abhishek Singh"
  description="Books Abhishek Singh is reading across world literature, philosophy, and political economy."
>
  <Header current="books" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Books & Reading
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        Notes on what I'm reading across world literature, political economy, philosophy, and history.
      </p>
    </div>

    <!-- Reading Philosophy / Rig -->
    <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/30 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed space-y-1.5">
      <p class="font-medium text-neutral-900 dark:text-neutral-200">How I read:</p>
      <p>
        I read primarily on a Kindle e-reader. Because I hated the bloated software ecosystem for sideloading books, I built <a href="/projects" class="underline hover:text-black dark:hover:text-white">Gatsby</a> to manage my library, fix Kindle cover thumbnail bugs, and generate page numbers on the fly.
      </p>
    </div>

    <!-- Books List -->
    <div class="space-y-6">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-200 dark:border-neutral-800 pb-2">
        Recent Books & Reflections
      </h2>

      <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
        {books.map((book) => (
          <div class="py-5 first:pt-0 space-y-2">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <h3 class="text-base font-medium text-neutral-900 dark:text-neutral-100">
                {book.title} <span class="text-neutral-400 font-normal">by {book.author}</span>
              </h3>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                  {book.genre}
                </span>
                <span class={`text-[11px] font-mono px-2 py-0.5 rounded-full ${
                  book.status === 'Reading' 
                    ? 'bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800' 
                    : 'bg-neutral-100 dark:bg-neutral-800 text-neutral-500'
                }`}>
                  {book.status}
                </span>
              </div>
            </div>
            
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              {book.notes}
            </p>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
