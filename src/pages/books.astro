---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const books = [
  { title: "When Breath Becomes Air", author: "Paul Kalanithi" },
  { title: "Flowers for Algernon", author: "Daniel Keyes" },
  { title: "The Tiger", author: "John Vaillant" },
  { title: "Diary of a Wimpy Kid: Double Down", author: "Jeff Kinney" },
  { title: "Case in Point: Complete Case Interview Preparation", author: "Marc P. Cosentino" },
  { title: "Case Interview Secrets", author: "Victor Cheng" },
  { title: "The Martian", author: "Andy Weir" },
  { title: "Project Hail Mary", author: "Andy Weir" },
  { title: "Ask the Dust", author: "John Fante" },
  { title: "James", author: "Percival Everett" },
  { title: "Being Mortal", author: "Atul Gawande" },
  { title: "Godan (गोदान)", author: "Premchand" },
  { title: "Notes on Complexity", author: "Neil Theise" },
  { title: "Zero: The Biography of a Dangerous Idea", author: "Charles Seife" },
  { title: "Ghachar Ghochar", author: "Vivek Shanbhag" },
  { title: "The Unbearable Lightness of Being", author: "Milan Kundera" },
  { title: "The Moon and Sixpence", author: "W. Somerset Maugham" },
  { title: "Pedro Páramo", author: "Juan Rulfo" },
  { title: "Notes from Underground", author: "Fyodor Dostoyevsky" },
  { title: "Awara Bheed Ke Khatare", author: "Harishankar Parsai" },
  { title: "Common Stocks and Common Sense", author: "Edgar Wachenheim, III" },
  { title: "A Matter of Rats: A Short Biography of Patna", author: "Amitava Kumar" },
  { title: "What is Life?", author: "Erwin Schrödinger" },
  { title: "The Remains of the Day", author: "Kazuo Ishiguro" },
  { title: "Metamorphosis", author: "Franz Kafka" },
  { title: "Train to Pakistan", author: "Khushwant Singh" },
  { title: "The Catcher in the Rye", author: "J.D. Salinger" },
  { title: "The Dragons of Eden", author: "Carl Sagan" },
  { title: "Animal Farm", author: "George Orwell" },
  { title: "To Kill a Mockingbird", author: "Harper Lee" },
  { title: "The Hitchhiker's Guide to the Galaxy", author: "Douglas Adams" },
  { title: "The Black Swan", author: "Nassim Nicholas Taleb" },
  { title: "The Snowball: Warren Buffett and the Business of Life", author: "Alice Schroeder" },
  { title: "Zero to One", author: "Peter Thiel" },
  { title: "Invent and Wander: The Collected Writings of Jeff Bezos", author: "Jeff Bezos" },
  { title: "Elon Musk", author: "Ashlee Vance" },
  { title: "Half Lion: How P.V. Narasimha Rao Transformed India", author: "Vinay Sitapati" },
  { title: "So Good They Can't Ignore You", author: "Cal Newport" },
  { title: "Tuesdays with Morrie", author: "Mitch Albom" },
  { title: "The Last Lecture", author: "Randy Pausch" },
  { title: "Emotional Intelligence", author: "Daniel Goleman" },
  { title: "Think Straight: Change Your Thoughts, Change Your Life", author: "Darius Foroux" },
  { title: "Lying", author: "Sam Harris" },
  { title: "How to Win Friends & Influence People", author: "Dale Carnegie" },
  { title: "Born Standing Up: A Comic's Life", author: "Steve Martin" },
];
---

<Layout 
  title="Books & Reading | Abhishek Singh"
  description="Books read by Abhishek Singh from his reading log."
>
  <Header current="books" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Books & Reading
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        A selection of books from my reading log, <a href="https://literal.club/abhisheksingh" target="_blank" rel="noopener noreferrer" class="underline hover:text-black dark:hover:text-white">Literal</a>, and <a href="https://www.goodreads.com/user/show/60944001-abhishek-singh" target="_blank" rel="noopener noreferrer" class="underline hover:text-black dark:hover:text-white">Goodreads</a>. I have read a lot more and will keep adding to this list over time.
      </p>
    </div>

    <!-- Reading Habit / Rig -->
    <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/30 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed space-y-1.5">
      <p class="font-medium text-neutral-900 dark:text-neutral-200">How I read:</p>
      <p>
        I read across paperbacks and e-ink (Kindle Paperwhite, Xteink). When reading digital e-books, I use <a href="/projects" class="underline hover:text-black dark:hover:text-white">Gatsby</a> to keep my offline library organized. I also occasionally listen to audiobooks.
      </p>
    </div>

    <!-- Books List -->
    <div class="space-y-4">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-200 dark:border-neutral-800 pb-2">
        Reading Log
      </h2>

      <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
        {books.map((book) => (
          <div class="py-2.5 first:pt-0 flex items-baseline justify-between gap-2">
            <h3 class="text-sm font-medium text-neutral-900 dark:text-neutral-100">
              {book.title} <span class="text-neutral-400 dark:text-neutral-500 font-normal">by {book.author}</span>
            </h3>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
