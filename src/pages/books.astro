---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const books = [
  {
    title: "The Martian",
    author: "Andy Weir",
    recommend: true,
  },
  {
    title: "Project Hail Mary",
    author: "Andy Weir",
    recommend: true,
  },
  {
    title: "Ask the Dust",
    author: "John Fante",
    recommend: true,
  },
  {
    title: "James",
    author: "Percival Everett",
    recommend: true,
  },
  {
    title: "Being Mortal",
    author: "Atul Gawande",
    recommend: true,
  },
  {
    title: "Godan (गोदान)",
    author: "Premchand",
    recommend: true,
  },
  {
    title: "Notes on Complexity",
    author: "Neil Theise",
    recommend: true,
  },
  {
    title: "Zero: The Biography of a Dangerous Idea",
    author: "Charles Seife",
    recommend: true,
  },
  {
    title: "Ghachar Ghochar",
    author: "Vivek Shanbhag",
    recommend: true,
  },
  {
    title: "The Unbearable Lightness of Being",
    author: "Milan Kundera",
    recommend: true,
  },
  {
    title: "The Moon and Sixpence",
    author: "W. Somerset Maugham",
    recommend: true,
  },
  {
    title: "Pedro Páramo",
    author: "Juan Rulfo",
    recommend: true,
  },
  {
    title: "Notes from Underground",
    author: "Fyodor Dostoyevsky",
    recommend: true,
  },
  {
    title: "Awara Bheed Ke Khatare",
    author: "Harishankar Parsai",
    recommend: false,
  },
  {
    title: "Common Stocks and Common Sense",
    author: "Edgar Wachenheim, III",
    recommend: false,
  },
  {
    title: "A Matter of Rats: A Short Biography of Patna",
    author: "Amitava Kumar",
    recommend: false,
  },
  {
    title: "What is Life?",
    author: "Erwin Schrödinger",
    recommend: false,
  },
];
---

<Layout 
  title="Books & Reading | Abhishek Singh"
  description="Books read by Abhishek Singh with recommendations."
>
  <Header current="books" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Books & Reading
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        A selection of books from my reading log. I have read a lot more and will keep adding to this list over time.
      </p>
    </div>

    <!-- Reading Habit / Rig -->
    <div class="p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/30 text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed space-y-1.5">
      <p class="font-medium text-neutral-900 dark:text-neutral-200">How I read:</p>
      <p>
        I read across paperbacks and e-ink (Kindle Paperwhite, Xteink). When reading digital e-books, I use <a href="/projects" class="underline hover:text-black dark:hover:text-white">Gatsby</a> to keep my offline library organized. I also occasionally listen to audiobooks.
      </p>
    </div>

    <!-- Books List -->
    <div class="space-y-4">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-200 dark:border-neutral-800 pb-2">
        Reading Log
      </h2>

      <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
        {books.map((book) => (
          <div class="py-3 first:pt-0 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <h3 class="text-sm font-medium text-neutral-900 dark:text-neutral-100">
              {book.title} <span class="text-neutral-400 dark:text-neutral-500 font-normal">by {book.author}</span>
            </h3>
            <div class="flex items-center gap-2 shrink-0">
              <span class={`text-[11px] font-mono px-2 py-0.5 rounded-full ${
                book.recommend 
                  ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900/40' 
                  : 'bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400'
              }`}>
                {book.recommend ? 'Recommend' : "Don't recommend"}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
