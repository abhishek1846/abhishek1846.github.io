---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0))
  .slice(0, 2);
---

<Layout title="Abhishek Singh">
  <Header current="home" />

  <main class="space-y-12">
    <!-- Calm Personal Intro -->
    <section class="space-y-3">
      <h1 class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100">
        Abhishek Singh
      </h1>
      <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        Staff Product Manager at <a href="https://oleria.com" target="_blank" rel="noopener noreferrer" class="text-neutral-900 dark:text-neutral-100 underline decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-black dark:hover:decoration-white">Oleria</a> leading product for Non-Human Identity (NHI) and AI Agent Governance. Two-time founder (<a href="/about" class="text-neutral-900 dark:text-neutral-100 underline decoration-neutral-300 dark:decoration-neutral-700 hover:decoration-black dark:hover:decoration-white">Komma</a>, Dashh). Based in Bengaluru.
      </p>
    </section>

    <!-- Photo, Paper & Talks Carousel -->
    <section>
      <PhotoCarousel />
    </section>

    <!-- Recent Writing (Simple, calm text list without heavy card boxes) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Writing
        </h2>
        <a href="/writing" class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          All essays →
        </a>
      </div>

      <div class="space-y-3">
        {posts.map((post) => (
          <article class="text-sm">
            <a 
              href={`/writing/${post.id}`} 
              class="text-neutral-800 dark:text-neutral-200 hover:text-blue-600 dark:hover:text-blue-400 transition-colors underline decoration-neutral-200 dark:decoration-neutral-800 hover:decoration-blue-500"
            >
              {post.data.title}
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- Projects (Simple clean line) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Projects
        </h2>
        <a href="/projects" class="text-xs text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          All projects →
        </a>
      </div>

      <div class="text-sm text-neutral-600 dark:text-neutral-400 flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <div class="flex items-center gap-2">
          <a 
            href="/projects" 
            class="font-medium text-neutral-900 dark:text-neutral-100 underline decoration-neutral-200 dark:decoration-neutral-800 hover:decoration-black dark:hover:decoration-white"
          >
            Gatsby
          </a>
          <span>- Minimalist macOS e-book manager & Kindle companion</span>
        </div>
        <a 
          href="https://github.com/abhishek1846/gatsby-releases/releases" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-xs font-mono text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 shrink-0"
        >
          v0.0.5 DMG ↗
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
