---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(date);
};
---

<Layout title="Abhishek Singh">
  <Header current="home" />

  <main class="space-y-12">
    <!-- Intro -->
    <section class="space-y-4">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Hi, I'm Abhishek.
      </h1>
      <p class="text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
        I am a Staff Product Manager and two-time founder based in Bengaluru. Currently leading product for 
        <span class="text-neutral-900 dark:text-white font-medium">Non-Human Identity (NHI) & AI Agent Governance</span> at 
        <a href="https://oleria.com" target="_blank" rel="noopener noreferrer" class="text-neutral-900 dark:text-neutral-100 underline decoration-neutral-300 hover:decoration-neutral-900 dark:decoration-neutral-700 dark:hover:decoration-neutral-200">Oleria</a>.
      </p>
      <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        I focus on enterprise identity security, agentic software systems, and building zero-bloat desktop tools.
      </p>
    </section>

    <!-- Click-only Photo / Paper / Talks Carousel linking to About -->
    <section>
      <PhotoCarousel />
    </section>

    <!-- Work Highlights Snapshot (Brief highlights only, linking to full resume) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Where I've Worked
        </h2>
        <a 
          href="/resume.pdf" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-xs font-mono text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white underline decoration-neutral-300 dark:decoration-neutral-700 transition-colors"
        >
          Full Resume (PDF) ↗
        </a>
      </div>

      <div class="space-y-3 text-sm">
        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Oleria</span>
            <span class="text-neutral-500 text-xs"> — Staff Product Manager (NHI & AI Governance)</span>
          </div>
          <span class="text-xs font-mono text-neutral-400 shrink-0">2025 — Present</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Kloudfuse</span>
            <span class="text-neutral-500 text-xs"> — Product & Growth Lead, India (Observability)</span>
          </div>
          <span class="text-xs font-mono text-neutral-400 shrink-0">2024 — 2025</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Komma</span>
            <span class="text-neutral-500 text-xs"> — Co-Founder & CEO (Acquired by Series A fintech)</span>
          </div>
          <span class="text-xs font-mono text-neutral-400 shrink-0">2022 — 2024</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">Dashh</span>
            <span class="text-neutral-500 text-xs"> — Co-Founder (1-click checkout)</span>
          </div>
          <span class="text-xs font-mono text-neutral-400 shrink-0">2021 — 2022</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">PharmEasy</span>
            <span class="text-neutral-500 text-xs"> — Senior Product Manager (Docon, 1M+ Rx/mo)</span>
          </div>
          <span class="text-xs font-mono text-neutral-400 shrink-0">2018 — 2021</span>
        </div>

        <div class="flex items-baseline justify-between">
          <div>
            <span class="font-medium text-neutral-900 dark:text-neutral-100">ZS Associates</span>
            <span class="text-neutral-500 text-xs"> — Decision Analytics Associate</span>
          </div>
          <span class="text-xs font-mono text-neutral-400 shrink-0">2017 — 2018</span>
        </div>
      </div>
    </section>

    <!-- Featured Project: Gatsby -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Featured Project
        </h2>
        <a href="/projects" class="text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          All projects →
        </a>
      </div>

      <div class="p-5 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white dark:bg-neutral-900/40 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Gatsby</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">macOS App</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900/40">v0.0.5</span>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-mono">
              Rust (Tauri v2) • React • TypeScript
            </p>
          </div>
          <a 
            href="https://github.com/abhisheksingh0196/gatsby-releases/releases" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-medium px-3 py-1.5 rounded-md bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 transition-opacity"
          >
            Download DMG ↗
          </a>
        </div>
        <p class="text-sm text-neutral-600 dark:text-neutral-300 mt-3 leading-relaxed">
          A hyper-minimalist e-book manager built exclusively for macOS. Bypasses Calibre's bloat (consumes ~40MB RAM) and solves Kindle cover thumbnail and APNX page number bugs automatically.
        </p>
        <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between text-xs text-neutral-500">
          <a href="/writing/building-gatsby-desktop-app" class="hover:text-black dark:hover:text-white transition-colors underline decoration-neutral-300 dark:decoration-neutral-700">
            Why I built Gatsby →
          </a>
          <a href="https://github.com/abhisheksingh0196/gatsby-releases" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
            GitHub ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Recent Writing -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-neutral-900">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Recent Writing
        </h2>
        <a href="/writing" class="text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          All essays →
        </a>
      </div>

      <div class="space-y-4">
        {posts.map((post) => (
          <article class="group">
            <a href={`/writing/${post.id}`} class="block space-y-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h3 class="text-sm font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {post.data.title}
                </h3>
                <span class="text-xs font-mono text-neutral-400 shrink-0">
                  {formatDate(post.data.pubDate)}
                </span>
              </div>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed line-clamp-2">
                {post.data.description}
              </p>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
