---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(date);
};
---

<Layout title="Abhishek Singh">
  <Header current="home" />

  <main class="space-y-12">
    <!-- Intro -->
    <section class="space-y-4">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Hi, I'm Abhishek.
      </h1>
      <p class="text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
        I am a Staff Product Manager and two-time former founder based in Bengaluru. Currently leading product for 
        <span class="text-neutral-900 dark:text-white font-medium">Non-Human Identity (NHI) & AI Agent Governance</span> at 
        <a href="https://oleria.com" target="_blank" rel="noopener noreferrer" class="text-neutral-900 dark:text-neutral-100 underline decoration-neutral-300 hover:decoration-neutral-900 dark:decoration-neutral-700 dark:hover:decoration-neutral-200">Oleria</a>.
      </p>
      <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        I love working at the intersection of deep technical infrastructure, 0-to-1 product strategy, and clean, unbloated software design.
      </p>
    </section>

    <!-- What I'm doing now -->
    <section class="space-y-3 p-4 rounded-xl border border-neutral-200/90 dark:border-neutral-800/80 bg-neutral-50/60 dark:bg-neutral-900/30">
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>What I'm focused on now</span>
      </div>
      <ul class="text-sm text-neutral-700 dark:text-neutral-300 space-y-2 list-disc pl-5 leading-relaxed">
        <li>
          Scaling identity security and autonomous AI agent discovery at Oleria across Fortune 500 environments.
        </li>
        <li>
          Building <a href="/projects" class="underline decoration-neutral-400 dark:decoration-neutral-600 hover:text-black dark:hover:text-white">Gatsby</a>, a native macOS e-book manager in Rust & Tauri to replace bloated legacy tools.
        </li>
        <li>
          Writing essays on machine credentials, agentic meshes, and lessons from building 0-to-1 startups.
        </li>
      </ul>
    </section>

    <!-- Recent Writing -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Recent Writing
        </h2>
        <a href="/writing" class="text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          All essays →
        </a>
      </div>

      <div class="space-y-5">
        {posts.map((post) => (
          <article class="group">
            <a href={`/writing/${post.id}`} class="block space-y-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h3 class="text-base font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {post.data.title}
                </h3>
                <span class="text-xs font-mono text-neutral-400 shrink-0">
                  {formatDate(post.data.pubDate)}
                </span>
              </div>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed line-clamp-2">
                {post.data.description}
              </p>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- Featured Craft: Gatsby -->
    <section class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800">
        <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400">
          Featured Project
        </h2>
        <a href="/projects" class="text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
          All projects →
        </a>
      </div>

      <div class="p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Gatsby</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">macOS App</span>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-900/40">v0.0.5</span>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-mono">
              Rust (Tauri v2) • React • TypeScript
            </p>
          </div>
          <a 
            href="https://github.com/abhisheksingh0196/gatsby-releases/releases" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-medium px-3 py-1.5 rounded-md bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 hover:opacity-90 transition-opacity"
          >
            Download DMG ↗
          </a>
        </div>
        <p class="text-sm text-neutral-600 dark:text-neutral-300 mt-3 leading-relaxed">
          A hyper-minimalist, lightning-fast e-book manager built exclusively for macOS. Bypasses Calibre's bloat (consumes ~40MB RAM) and solves Kindle cover thumbnail and APNX page number bugs automatically.
        </p>
        <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between text-xs text-neutral-500">
          <a href="/writing/building-gatsby-desktop-app" class="hover:text-black dark:hover:text-white transition-colors underline decoration-neutral-300 dark:decoration-neutral-700">
            Why I built Gatsby →
          </a>
          <a href="https://github.com/abhisheksingh0196/gatsby-releases" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
            GitHub ↗
          </a>
        </div>
      </div>
    </section>

    <!-- Quick Navigation Links -->
    <section class="pt-4 border-t border-neutral-200 dark:border-neutral-800 flex flex-wrap gap-4 text-xs font-mono text-neutral-500">
      <span>Explore:</span>
      <a href="/work" class="hover:text-neutral-900 dark:hover:text-neutral-100 underline">Work & Experience</a>
      <a href="/projects" class="hover:text-neutral-900 dark:hover:text-neutral-100 underline">Projects</a>
      <a href="/books" class="hover:text-neutral-900 dark:hover:text-neutral-100 underline">Reading List</a>
      <a href="/uses" class="hover:text-neutral-900 dark:hover:text-neutral-100 underline">Tools I Use</a>
      <a href="/about" class="hover:text-neutral-900 dark:hover:text-neutral-100 underline">About Me</a>
    </section>
  </main>

  <Footer />
</Layout>
