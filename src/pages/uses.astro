---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    title: "Hardware & Everyday Carry",
    items: [
      {
        name: "MacBook Pro (Work) & MacBook Air (Personal)",
        description: "MacBook Pro for work and compiling builds; MacBook Air as my lightweight, fanless personal daily driver.",
      },
      {
        name: "iPhone 13 mini",
        description: "Holding on to this small form factor for as long as I can. Got the battery replaced and it works remarkably well.",
      },
      {
        name: "iPhone SE (2020)",
        description: "Secondary phone kept around for backups and secondary SIM.",
      },
      {
        name: "Kindle Paperwhite Signature Edition & Xteink 4",
        description: "Distraction-free e-ink reading. My entire offline library is curated and synced via Gatsby.",
      },
      {
        name: "Samsung Monitor",
        description: "It works; haven't cared enough to check the model number. Looking for good monitor recommendations.",
      },
      {
        name: "Logitech MX Master 3S, Magic Keyboard & Magic Trackpad",
        description: "My daily desk input setup. Quiet tactile clicks paired with smooth native macOS gestures.",
      },
      {
        name: "AirPods (with ANC) & Wired Apple EarPods",
        description: "AirPods for focus and travel noise cancellation; classic 3.5mm/Lightning wired EarPods for meetings—zero latency, great mic clarity, and no battery anxiety.",
      },
      {
        name: "Anker MagSafe Power Bank (5,000 mAh) & MagSafe Charger",
        description: "Small, snap-on travel companion for all-day peace of mind without cables dangling.",
      },
    ],
  },
  {
    title: "Software & Daily Tools",
    items: [
      {
        name: "Gatsby",
        description: "My native macOS e-book manager built with Rust & Tauri. Clean, lightning fast, and zero bloat.",
      },
      {
        name: "Zed",
        description: "High-performance, lightweight code editor written in Rust. Fast startup and minimal UI.",
      },
      {
        name: "Nota (nota.md)",
        description: "Paid once years ago. They don't update it anymore, but it remains an amazing distraction-free Markdown app.",
      },
      {
        name: "Ghostty",
        description: "Native, GPU-accelerated terminal emulator for daily command-line workflows.",
      },
      {
        name: "Raycast",
        description: "Fast keyboard launcher replacing Spotlight for shortcuts, window snapping, and workflow automation.",
      },
      {
        name: "Maccy",
        description: "Superfast, lightweight native macOS clipboard manager with keyboard navigation.",
      },
      {
        name: "Rocket",
        description: "Slack-style emoji picker everywhere on macOS with colon-completion (:rocket:). Bought it once, couldn't live without it.",
      },
      {
        name: "Firefox & Safari",
        description: "Firefox as my primary everyday browser; Safari as my fast secondary browser.",
      },
      {
        name: "Apple Music & YouTube Music",
        description: "Apple Music is my primary sanctuary for curated listening. YouTube Music is strictly for off-beat and casual listening so as to never corrupt my Apple Music algorithm.",
      },
    ],
  },
];
---

<Layout 
  title="Uses | Abhishek Singh"
  description="Tools, hardware, software, and development stack used by Abhishek Singh."
>
  <Header current="uses" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Uses & Tools
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        A living list of the hardware, desktop software, developer tools, and everyday setup I use to stay productive.
      </p>
    </div>

    <div class="space-y-10">
      {categories.map((cat) => (
        <section class="space-y-4">
          <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-200 dark:border-neutral-800 pb-2">
            {cat.title}
          </h2>

          <div class="grid grid-cols-1 gap-4">
            {cat.items.map((item) => (
              <div class="p-4 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30">
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                  {item.name}
                </h3>
                <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
