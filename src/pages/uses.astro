---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    title: "Hardware & Desk",
    items: [
      {
        name: "MacBook Pro (Apple Silicon)",
        description: "Primary workhorse for product management, engineering, and desktop app compilation.",
      },
      {
        name: "Amazon Kindle",
        description: "My daily distraction-free reading device. Sideloaded with non-Amazon books via Gatsby.",
      },
      {
        name: "External 4K Monitor & Audio",
        description: "Clean single-cable USB-C desk setup paired with Sony noise-canceling headphones for deep focus.",
      },
    ],
  },
  {
    title: "Desktop Apps & Daily Utilities",
    items: [
      {
        name: "Gatsby",
        description: "My own native macOS e-book manager built with Rust & Tauri. Used to manage my entire e-book library and sync to Kindle with zero bloat.",
      },
      {
        name: "Cursor / VS Code",
        description: "My editor of choice for engineering projects, writing scripts, and tinkering with agent SDKs.",
      },
      {
        name: "Raycast",
        description: "Fast keyboard launcher replacing Spotlight, managing clipboard history, window management, and quick snippets.",
      },
      {
        name: "Terminal Setup",
        description: "Zsh with modern CLI utilities (eza, bat, ripgrep, fzf) for high-speed local exploration.",
      },
      {
        name: "Arc & Chrome",
        description: "Arc for personal workflows and deep focus spaces; Chrome for testing enterprise SaaS consoles and extensions.",
      },
    ],
  },
  {
    title: "Engineering & Product Stack",
    items: [
      {
        name: "Languages & Frameworks",
        description: "Rust (systems & native desktop), TypeScript, React, Python, Astro, and Tailwind CSS.",
      },
      {
        name: "Desktop Engine",
        description: "Tauri v2 for lightweight cross-platform native binaries without Electron's memory overhead.",
      },
      {
        name: "Identity & Security",
        description: "Deep daily work with Non-Human Identities (NHIs), AWS IAM, GCP IAM, Microsoft Entra ID, and Model Context Protocol (MCP).",
      },
    ],
  },
];
---

<Layout 
  title="Uses | Abhishek Singh"
  description="Tools, hardware, software, and development stack used by Abhishek Singh."
>
  <Header current="uses" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Uses & Tools
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        A living list of the hardware, desktop software, developer tools, and everyday setup I use to stay productive.
      </p>
    </div>

    <div class="space-y-10">
      {categories.map((cat) => (
        <section class="space-y-4">
          <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-200 dark:border-neutral-800 pb-2">
            {cat.title}
          </h2>

          <div class="grid grid-cols-1 gap-4">
            {cat.items.map((item) => (
              <div class="p-4 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30">
                <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                  {item.name}
                </h3>
                <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
