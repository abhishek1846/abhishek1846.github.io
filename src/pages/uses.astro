---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const categories = [
  {
    title: "Hardware & Everyday Carry",
    items: [
      {
        name: "MacBook Pro (Work) & MacBook Air (Personal)",
        description: "MacBook Pro for work and compiling builds; MacBook Air as my lightweight, fanless personal daily driver.",
      },
      {
        name: "iPhone 13 mini",
        description: "Holding on to this small form factor for as long as I can. Got the battery replaced and it works remarkably well.",
      },
      {
        name: "iPhone SE (2020)",
        description: "Secondary phone kept around for backups and secondary SIM.",
      },
      {
        name: "Kindle Paperwhite Signature Edition & Xteink 4",
        description: "Distraction-free e-ink reading. My entire offline library is curated and synced via Gatsby.",
      },
      {
        name: "Samsung Monitor",
        description: "It works; haven't cared enough to check the model number. Looking for good monitor recommendations.",
      },
      {
        name: "Logitech MX Master 3S, Magic Keyboard & Magic Trackpad",
        description: "My daily desk input setup. Quiet tactile clicks paired with smooth native macOS gestures.",
      },
      {
        name: "AirPods (with ANC) & Wired Apple EarPods",
        description: "AirPods for focus and travel noise cancellation. Wired EarPods for meetings because they have zero latency and never run out of battery.",
      },
      {
        name: "Anker MagSafe Power Bank (5,000 mAh) & MagSafe Charger",
        description: "Small travel battery that snaps on without tangled cables.",
      },
    ],
  },
  {
    title: "Software & Daily Tools",
    items: [
      {
        name: "Gatsby",
        url: "/projects",
        description: "My native macOS e-book manager built with Rust and Tauri. Fast and focused on the basics.",
      },
      {
        name: "Zed",
        url: "https://zed.dev",
        description: "Lightweight code editor written in Rust. Fast startup and clean design.",
      },
      {
        name: "Nota (nota.md)",
        url: "https://nota.md",
        description: "Paid once years ago. They stopped updating it, but it is still a great local markdown app.",
      },
      {
        name: "Ghostty",
        url: "https://ghostty.org",
        description: "Native terminal emulator with GPU acceleration.",
      },
      {
        name: "Raycast",
        url: "https://raycast.com",
        description: "Replaces Spotlight for window management and quick shortcuts.",
      },
      {
        name: "Maccy",
        url: "https://maccy.app",
        description: "Lightweight clipboard manager that stays out of the way.",
      },
      {
        name: "Rocket",
        url: "https://matthewpalmer.net/rocket/",
        description: "Slack-style emoji picker everywhere on macOS. Bought it once and use it every day.",
      },
      {
        name: "Firefox & Safari",
        links: [
          { name: "Firefox", url: "https://www.mozilla.org/firefox/" },
          { name: "Safari", url: "https://www.apple.com/safari/" },
        ],
        description: "Firefox as my primary everyday browser; Safari as my fast secondary browser.",
      },
      {
        name: "Apple Music & YouTube Music",
        links: [
          { name: "Apple Music", url: "https://music.apple.com" },
          { name: "YouTube Music", url: "https://music.youtube.com" },
        ],
        description: "Apple Music is my primary sanctuary for curated listening. YouTube Music is strictly for off-beat and casual listening so as to never corrupt my Apple Music algorithm.",
      },
    ],
  },
];
---

<Layout 
  title="Uses | Abhishek Singh"
  description="Tools, hardware, software, and development stack used by Abhishek Singh."
>
  <Header current="uses" />

  <main class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Uses & Tools
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        A living list of the hardware, desktop software, developer tools, and everyday setup I use to stay productive.
      </p>
    </div>

    <div class="space-y-10">
      {categories.map((cat) => (
        <section class="space-y-4">
          <h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 border-b border-neutral-200 dark:border-neutral-800 pb-2">
            {cat.title}
          </h2>

          <div class="grid grid-cols-1 gap-4">
            {cat.items.map((item: any) => (
              <div class="p-4 rounded-xl border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50/50 dark:bg-neutral-900/30">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                    {item.url ? (
                      <a 
                        href={item.url} 
                        target={item.url.startsWith('http') ? '_blank' : undefined} 
                        rel={item.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="hover:underline underline-offset-2 inline-flex items-center gap-1 group"
                      >
                        <span>{item.name}</span>
                        <span class="text-xs text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-700 dark:group-hover:text-neutral-300 font-normal">
                          {item.url.startsWith('http') ? '↗' : '→'}
                        </span>
                      </a>
                    ) : (
                      <span>{item.name}</span>
                    )}
                  </h3>

                  {item.links && (
                    <div class="flex items-center gap-3 text-xs">
                      {item.links.map((link: { name: string; url: string }) => (
                        <a 
                          href={link.url} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          class="text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 underline underline-offset-2"
                        >
                          {link.name} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
                <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-relaxed">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
